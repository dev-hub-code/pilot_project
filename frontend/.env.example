# Copy to .env.local (git-ignored). Server-side only: never prefix these with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8080
BACKEND_TIMEOUT_MS=10000

# Must match the backend's JWT_ISSUER / JWT_AUDIENCE.
JWT_ISSUER=https://api.sealease.local
JWT_AUDIENCE=sealease-api

# Secure (HTTPS-only, __Host- prefixed) cookies. Defaults to true in production builds.
# Set to false only for plain-HTTP local runs of `next start`.
# COOKIE_SECURE=false
