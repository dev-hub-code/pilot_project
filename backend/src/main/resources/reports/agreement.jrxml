<!--
  Lease agreements (see AgreementRenderer). The wording is the admin's template filled in for one investment: each
  row is a paragraph, or a heading (bold) for a line that started with "# ". Same look and embedded DejaVu fonts
  as document.jrxml.
-->
<jasperReport name="agreement" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="495" leftMargin="50" rightMargin="50" topMargin="40" bottomMargin="36" uuid="5b1f0c64-8f3e-4d55-9a4c-2d7e1f6b9c10">
	<style name="Base" default="true" forecolor="#0B1F2A" fontName="DejaVu Sans" fontSize="9.5"/>
	<style name="Paragraph" style="Base">
		<conditionalStyle fontSize="11.0" bold="true">
			<conditionExpression><![CDATA[$F{heading}]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="subtitle" class="java.lang.String"/>
	<parameter name="footnote" class="java.lang.String"/>
	<!-- Set once the investor has accepted: their signature from identity verification (null if none on file). -->
	<parameter name="signature" class="java.lang.Object"/>
	<parameter name="signedBy" class="java.lang.String"/>
	<parameter name="signedOn" class="java.lang.String"/>
	<field name="text" class="java.lang.String"/>
	<field name="heading" class="java.lang.Boolean"/>
	<title height="116">
		<element kind="image" uuid="5e1a7c2d-8b4f-4d3a-9c6e-2f7b0a1d3e52" x="0" y="0" width="56" height="45" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Middle">
			<expression><![CDATA["reports/logo.png"]]></expression>
		</element>
		<element kind="textField" uuid="0f6a2a5e-3b8c-4c1e-9d8b-6e2f4a1c7b01" x="66" y="14" width="429" height="18" forecolor="#0F1F38" fontSize="13.0" bold="true" blankWhenNull="true" hTextAlign="Left" style="Base">
			<expression><![CDATA["SEALEASE"]]></expression>
		</element>
		<element kind="textField" uuid="7c3e1b9a-5d2f-4a6b-8e1c-9f0a3b5d7e02" x="0" y="52" width="495" height="26" forecolor="#0B1F2A" fontSize="18.0" textAdjust="StretchHeight" bold="true" blankWhenNull="true" hTextAlign="Left" style="Base">
			<expression><![CDATA[$P{title}]]></expression>
		</element>
		<element kind="textField" uuid="2a9d4c7e-1b3f-4e5a-8c6d-0e7f9a1b3c03" x="0" y="82" width="495" height="16" forecolor="#5B6770" fontSize="9.5" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" style="Base">
			<expression><![CDATA[$P{subtitle}]]></expression>
		</element>
		<element kind="line" uuid="9e5b2d8f-4c1a-4b7e-a3d6-1f8c0e2a4b04" x="0" y="106" width="495" height="1" forecolor="#1F62C9">
			<pen lineWidth="1.5"/>
		</element>
	</title>
	<detail>
		<band height="18">
			<element kind="textField" uuid="4d8f1a6c-2e9b-4c3d-b5a7-6c0e8f2a1d05" x="0" y="0" width="495" height="18" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" style="Paragraph">
				<paragraph lineSpacing="Proportional" lineSpacingSize="1.25"/>
				<box topPadding="4" bottomPadding="4" style="Paragraph"/>
				<expression><![CDATA[$F{text}]]></expression>
			</element>
		</band>
	</detail>
	<summary height="120">
		<element kind="frame" uuid="3c7d9e1f-2a4b-4c6d-8e0f-1a3b5c7d9e21" x="0" y="14" width="240" height="104">
			<printWhenExpression><![CDATA[$P{signedBy} != null]]></printWhenExpression>
			<element kind="staticText" uuid="5e9f1a3b-4c6d-4e8f-a0b2-3c5d7e9f1a22" x="0" y="0" width="240" height="14" forecolor="#5B6770" fontSize="8.5" style="Base">
				<text><![CDATA[Signed by the Investor]]></text>
			</element>
			<element kind="image" uuid="7a1b3c5d-6e8f-4a0b-9c2d-4e6f8a0b2c23" x="0" y="16" width="180" height="50" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Bottom" usingCache="true" onErrorType="Blank">
				<printWhenExpression><![CDATA[$P{signature} != null]]></printWhenExpression>
				<expression><![CDATA[$P{signature}]]></expression>
			</element>
			<element kind="staticText" uuid="2d4e6f8a-9b1c-4d3e-8f5a-6b7c8d9e0f27" x="0" y="34" width="240" height="14" forecolor="#5B6770" fontSize="8.0" italic="true" style="Base">
				<printWhenExpression><![CDATA[$P{signature} == null]]></printWhenExpression>
				<text><![CDATA[No signature image on file; accepted electronically.]]></text>
			</element>
			<element kind="line" uuid="9b2c4d6e-8f0a-4b1c-9d3e-5f7a9b1c3d24" x="0" y="68" width="200" height="1" forecolor="#0B1F2A">
				<pen lineWidth="0.75"/>
			</element>
			<element kind="textField" uuid="1c3d5e7f-0a2b-4c4d-8e6f-7a9b1c3d5e25" x="0" y="72" width="240" height="14" bold="true" blankWhenNull="true" style="Base">
				<expression><![CDATA[$P{signedBy}]]></expression>
			</element>
			<element kind="textField" uuid="4f6a8b0c-1d3e-4f5a-9b7c-8d0e2f4a6b26" x="0" y="86" width="240" height="14" forecolor="#5B6770" fontSize="8.5" blankWhenNull="true" style="Base">
				<expression><![CDATA[$P{signedOn}]]></expression>
			</element>
		</element>
	</summary>
	<pageFooter height="44">
		<!-- Once accepted, the investor's signature on every page, above the page number. -->
		<element kind="frame" uuid="6d8e0f2a-3b5c-4d7e-9f1a-2b4c6d8e0f31" x="335" y="0" width="160" height="26">
			<printWhenExpression><![CDATA[$P{signedBy} != null]]></printWhenExpression>
			<element kind="staticText" uuid="8f0a2b4c-5d7e-4f9a-8b1c-3d5e7f9a1b32" x="0" y="12" width="58" height="12" forecolor="#5B6770" fontSize="6.5" hTextAlign="Right" style="Base">
				<text><![CDATA[Investor:]]></text>
			</element>
			<element kind="image" uuid="0a2b4c6d-7e9f-4a1b-9c3d-5e7f9a1b3c33" x="62" y="0" width="98" height="24" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Bottom" usingCache="true" onErrorType="Blank">
				<printWhenExpression><![CDATA[$P{signature} != null]]></printWhenExpression>
				<expression><![CDATA[$P{signature}]]></expression>
			</element>
			<element kind="textField" uuid="2b4c6d8e-9f1a-4b3c-8d5e-7f9a1b3c5d34" x="62" y="12" width="98" height="12" fontSize="7.0" bold="true" blankWhenNull="true" style="Base">
				<printWhenExpression><![CDATA[$P{signature} == null]]></printWhenExpression>
				<expression><![CDATA[$P{signedBy}]]></expression>
			</element>
			<element kind="line" uuid="4c6d8e0f-1a3b-4c5d-9e7f-9a1b3c5d7e35" x="62" y="25" width="98" height="1" forecolor="#9AA4AB">
				<pen lineWidth="0.5"/>
			</element>
		</element>
		<element kind="textField" uuid="6b2c9e4a-7d1f-4a8b-9c3e-5f0d2a7b1c06" x="0" y="24" width="400" height="18" forecolor="#5B6770" fontSize="6.5" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" style="Base">
			<expression><![CDATA[$P{footnote} == null ? "" : $P{footnote}]]></expression>
		</element>
		<element kind="textField" uuid="1e7a3c5b-9d2f-4b6a-8e4c-0a1b3d5f7e07" x="400" y="30" width="75" height="12" forecolor="#5B6770" fontSize="7.0" blankWhenNull="true" hTextAlign="Right" style="Base">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></expression>
		</element>
		<element kind="textField" uuid="8c4e6a2d-1f3b-4d5c-9a7e-2b0c4e6f8a08" x="475" y="30" width="20" height="12" forecolor="#5B6770" fontSize="7.0" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" style="Base">
			<box leftPadding="3" style="Base"/>
			<expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
