# HTTPS certificates for both names come from Let's Encrypt automatically, once GoDaddy points them at the server.
# Caddy sets X-Forwarded-For to the visitor's address (ignoring any the visitor sent), which the web app passes on to
# the API for rate limits and audit records.
{
	email admin@sealease.in
}

www.sealease.in {
	encode zstd gzip
	reverse_proxy frontend:3000
}

sealease.in {
	redir https://www.sealease.in{uri} permanent
}

# Temporary: the site at the server's IP until the domain resolves. The certificate is Caddy's own (browsers warn);
# HTTPS is still needed because the sign-in cookies are Secure. Remove once www.sealease.in works.
https://52.62.97.231 {
	tls internal
	encode zstd gzip
	reverse_proxy frontend:3000
}
