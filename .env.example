# Copy to .env (git-ignored) and adjust. Read by docker compose and by the backend's local profile.

# --- PostgreSQL ---
DB_NAME=sealease
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/sealease
DB_USERNAME=sealease
DB_PASSWORD=change-me-locally

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT (RS256) --- generate with: scripts/generate-jwt-keys.sh
JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/to/repo/.secrets/jwt-private.pem
JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/to/repo/.secrets/jwt-public.pem
JWT_ISSUER=https://api.sealease.local
JWT_AUDIENCE=sealease-api

# --- Field encryption (tax ids, KYC documents, bank accounts) --- generate with:
#     scripts/generate-encryption-keys.sh
APP_CRYPTO_DATA_KEYS=
APP_CRYPTO_ACTIVE_KEY_ID=
APP_CRYPTO_FINGERPRINT_KEY=

# --- First super-admin (created once while no SUPER_ADMIN exists; remove afterwards) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Backend ---
SERVER_PORT=8080
APP_DEFAULT_CURRENCY=INR
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Payments & invoices ---
# The local profile has demo defaults for the invoice issuer; production fails to start without them.
# The bank accounts investors pay into are managed in the admin console, not here.
# INVOICE_ISSUER_NAME=
# INVOICE_ISSUER_ADDRESS=
# INVOICE_ISSUER_TAX_ID=        # the company's GSTIN; its first 2 digits are its state for GST
# INVOICE_ISSUER_STATE=         # only if the tax ID is not a GSTIN, e.g. Maharashtra (local default)
#   GST: buyers in the company's state pay CGST + SGST, others IGST (rate set per plan).
# APP_ORDER_PAYMENT_WINDOW=30m
# APP_BANK_PAYMENT_VERIFICATION_WINDOW=7d

# --- Notification emails ---
# The local profile sends them to Mailpit from docker compose (inbox: http://localhost:8025).
# Gmail: turn on 2-Step Verification, create an App Password at https://myaccount.google.com/apppasswords
# (16 letters, enter without spaces), then set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<gmail
# address>, MAIL_PASSWORD=<app password>, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true. The sender defaults to
# MAIL_USERNAME. Gmail allows about 500 emails a day; use a provider such as SES or SendGrid beyond that.
# Any SMTP server:
# APP_NOTIFICATION_EMAIL_ENABLED=true
# APP_NOTIFICATION_EMAIL_FROM=SeaLease <no-reply@example.com>
# APP_PUBLIC_URL=http://localhost:3000
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# --- Sign-up email verification ---
# New accounts must follow an emailed link before they can sign in (sent with the mail settings above).
# APP_EMAIL_VERIFICATION_REQUIRED=true
# APP_EMAIL_VERIFICATION_LINK_TTL=24h

# --- Cash at the office (paying orders, collecting withdrawals) ---
# APP_OFFICE_ADDRESS=              # defaults to INVOICE_ISSUER_ADDRESS
# APP_OFFICE_HOURS=Monday to Friday, 10:00 to 17:00
# APP_OFFICE_HOLD_WINDOW=3d        # how long an order waits for the investor to pay at the office

# Rent credit step (default 1h). Only shorten it locally to test crediting, e.g. 5m.
# APP_PAYOUT_CREDIT_INTERVAL=5m
